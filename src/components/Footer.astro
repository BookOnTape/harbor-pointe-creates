---
import Wordmark from './Wordmark.astro';
---

<footer class="footer">
  <div class="footer-inner container">
    <Wordmark size="15px" />
    <div class="footer-links">
      <a href="/track">Track a request</a>
      <a href="https://harborpointedesigns.com" target="_blank" rel="noopener">Harbor Pointe Designs ↗</a>
    </div>
    <div class="footer-meta">© 2026 Harbor Pointe · made on a printer in the corner of the office</div>
  </div>
</footer>

<style>
  .footer { background: var(--ink-deep); color: var(--paper); padding-block: 40px; }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
  }
  .footer-links, .footer-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper-45);
  }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { color: inherit; text-decoration: none; }
  .footer-links a:hover { color: var(--seaglass); }
</style>
