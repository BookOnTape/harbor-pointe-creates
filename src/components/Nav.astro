---
import Wordmark from './Wordmark.astro';
interface Props { tone?: 'paper' | 'ink'; }
const { tone = 'paper' } = Astro.props;
---

<nav class:list={['nav container', `nav-${tone}`]}>
  <a href="/" class="nav-brand" aria-label="Harbor Pointe Creates — home">
    <Wordmark tone={tone} size="18px" />
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/#how">How it works</a>
      <a href="/#sources">Find a file</a>
      <a href="/track">Track a request</a>
    </div>
    <a href="/#request" class="nav-cta">Request a print</a>
  </div>
</nav>

<style>
  .nav {
    position: relative;
    padding-top: 26px;
    padding-bottom: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .nav-brand { text-decoration: none; }
  .nav-right { display: flex; align-items: center; gap: 34px; }
  .nav-links {
    display: flex;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .nav-paper .nav-links { color: var(--paper-60); }
  .nav-ink .nav-links { color: var(--slate); }
  .nav-links a { color: inherit; text-decoration: none; }
  .nav-paper .nav-links a:hover { color: var(--paper); }
  .nav-ink .nav-links a:hover { color: var(--ink); }
  .nav-cta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--signal);
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 500;
    transition: filter var(--ease);
  }
  .nav-cta:hover { filter: brightness(1.06); }
  @media (max-width: 720px) {
    .nav-links { display: none; }
  }
</style>
